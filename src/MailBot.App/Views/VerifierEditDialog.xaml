<Window x:Class="MailBot.App.Views.VerifierEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="验证邮箱" Width="500" Height="450" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="邮箱地址:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="EmailBox" Margin="0,4"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="IMAP 服务器:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="HostBox" Margin="0,4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="端口:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="PortBox" Margin="0,4"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="用户名:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="UsernameBox" Margin="0,4"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="登录凭据:" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PasswordBox" Margin="0,4"/>
        <TextBlock Grid.Row="5" Grid.Column="1" Text="QQ 填授权码、Gmail 填应用专用密码"
                   Foreground="{StaticResource Brush.Accent.GrayText}" FontSize="11" Margin="0,0,0,8"/>

        <CheckBox Grid.Row="6" Grid.Column="1" x:Name="SslCheck" Content="使用 SSL/TLS" IsChecked="True" Margin="0,4"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                   x:Name="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.Accent.Hint}" />

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource Button.Link}" Content="测试连接" Margin="0,0,4,0" Click="OnTestConnection"/>
            <Button Style="{StaticResource Button.Link}" Content="取消" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Style="{StaticResource Button.Primary}" Content="保存" Width="80" Click="OnSave" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>