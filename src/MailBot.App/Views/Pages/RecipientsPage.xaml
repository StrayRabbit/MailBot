<UserControl x:Class="MailBot.App.Views.Pages.RecipientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MailBot.App.Converters">
    <UserControl.Resources>
        <conv:RecipientStatusToTextConverter x:Key="RecipientStatusText" />
        <!-- 把 DateTime? 格式化为 "yyyy-MM-dd HH:mm"，null 显示 "—" -->
        <conv:IsoDateConverter x:Key="IsoDate" />
    </UserControl.Resources>
    <!--
        性能要点：DataGrid 必须直接占满空间，自己持有 ScrollViewer。
        之前用 ScrollViewer > StackPanel > DataGrid 会让外层 ScrollViewer 把 DataGrid 撑高到自然尺寸，
        导致 DataGrid 的行虚拟化失效（每行都被实际渲染），且鼠标滚轮事件被外层拦截，体验卡顿。
    -->
    <GroupBox Header="▼ 收件人" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部工具栏：导入/导出 + 切换全选 + 重置/删除 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="导入 Excel/CSV" Margin="0,0,4,0" Click="ImportRecipients_Click" />
                <Button Content="导出结果" Margin="0,0,16,0" Click="ExportRecipients_Click" />

                <!-- 标签动态切换：未全选 → "全选"；全选 → "取消全选" -->
                <Button Content="{Binding Recipients.ToggleAllLabel}"
                        Command="{Binding Recipients.ToggleSelectAllCommand}"
                        MinWidth="80" Margin="0,0,16,0" />

                <Button Content="重置选中" Margin="0,0,4,0" Click="ResetSelected_Click" />
                <Button Content="编辑" Margin="0,0,4,0" Click="EditRecipient_Click"
                        ToolTip="修改高亮选中行的邮箱与状态（双击行也可打开）" />
                <Button Content="删除选中" Click="DeleteSelected_Click" />

                <!-- 破坏性操作：红色 + 顶格间距隔开，避免和常规批量操作混淆 -->
                <Button Style="{StaticResource Button.Danger}"
                        Content="清空所有"
                        Margin="16,0,0,0"
                        Click="ClearAll_Click"
                        ToolTip="删除收件人表中的全部记录，不受筛选/勾选影响。不可恢复。" />
            </StackPanel>

            <!-- 筛选 + 计数 + 查询 -->
            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" x:Name="StatusFilter" SelectionChanged="StatusFilter_Changed"
                          MinWidth="140">
                    <!-- Content=中文显示标签；Tag=数据库原值（筛选查询用，不做改动） -->
                    <ComboBoxItem Content="全部"   Tag="all"         IsSelected="True" />
                    <ComboBoxItem Content="待发送" Tag="pending" />
                    <ComboBoxItem Content="已发送" Tag="sent" />
                    <ComboBoxItem Content="已送达" Tag="verified" />
                    <ComboBoxItem Content="验证中" Tag="unverified" />
                    <ComboBoxItem Content="失败"   Tag="failed" />
                    <ComboBoxItem Content="已屏蔽" Tag="blocked" />
                    <ComboBoxItem Content="未确认" Tag="unconfirmed" />
                </ComboBox>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Run Text="当前筛选:" />
                    <Run Text="{Binding Recipients.TotalCount, Mode=OneWay}" />
                    <Run Text=" 条    已勾选: " />
                    <Run Text="{Binding Recipients.SelectedCount, Mode=OneWay}" />
                    <Run Text=" 条 (跨页累计)" />
                </TextBlock>
                <!-- 查询：单框，含 '@' 视为邮箱子串，否则视为批次号精确。回车或点搜索按钮触发 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBox x:Name="QueryTextBox" Width="280" VerticalContentAlignment="Center"
                             ToolTip="默认按邮箱子串查；含 '-' 且含数字时按批次号精确查。回车查询。"
                             Text="{Binding Recipients.QueryText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Recipients.ApplyQueryCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="搜索" Margin="4,0,0,0" MinWidth="60"
                            Command="{Binding Recipients.ApplyQueryCommand}" />
                    <Button Content="清空" Margin="4,0,0,0" MinWidth="60"
                            Command="{Binding Recipients.ClearQueryCommand}" />
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="2" x:Name="RecipientsGrid"
                      ItemsSource="{Binding Recipients.Recipients}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      MouseDoubleClick="RecipientsGrid_MouseDoubleClick"
                      RowHeaderWidth="0"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.IsContainerVirtualizable="True"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      Margin="0,4,0,0">
                <!-- 选中行高亮，便于一眼看出哪些行被勾选 -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Row.Selected}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Row.SelectedBorder}" />
                                <Setter Property="BorderThickness" Value="3,0,0,0" />
                                <Setter Property="Foreground" Value="{StaticResource Brush_Accent_Default}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="50" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="选择" Width="50" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--
                                    Click 处理器是 TwoWay 绑定的安全网：
                                    DataGrid 进入编辑模式时，模板列里的 CheckBox 状态可能不会写回源，
                                    所以这里显式调 VM.SelectRow/DeselectRow 同步 _selectedIds。
                                -->
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Click="RowCheck_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="邮箱" Binding="{Binding Email}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="批次号"
                                        Binding="{Binding BatchId}" Width="170" IsReadOnly="True" />
                    <DataGridTextColumn Header="发送次数"
                                        Binding="{Binding AttemptCount}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="最后活动"
                                        Binding="{Binding LastActivityAt, Converter={StaticResource IsoDate}}"
                                        Width="140" IsReadOnly="True" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status, Converter={StaticResource RecipientStatusText}}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="错误" Binding="{Binding ErrorMessage}" Width="*" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 分页 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="上一页" Command="{Binding Recipients.PrevPageCommand}" MinWidth="80" />
                <TextBlock VerticalAlignment="Center" Margin="12,0">
                    <Run Text="第 " />
                    <Run Text="{Binding Recipients.PageIndexDisplay, Mode=OneWay}" />
                    <Run Text=" / " />
                    <Run Text="{Binding Recipients.PageCount, Mode=OneWay}" />
                    <Run Text=" 页    每页 " />
                    <Run Text="{Binding Recipients.PageSize, Mode=OneTime}" />
                    <Run Text=" 条" />
                </TextBlock>
                <Button Content="下一页" Command="{Binding Recipients.NextPageCommand}" MinWidth="80" Margin="12,0,0,0" />
            </StackPanel>
        </Grid>
    </GroupBox>
</UserControl>