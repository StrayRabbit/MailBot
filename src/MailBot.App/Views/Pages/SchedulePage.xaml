<UserControl x:Class="MailBot.App.Views.Pages.SchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <GroupBox Header="▼ 发送调度">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="窗口:" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding WindowStart}" Width="60"
                                 LostFocus="HHmm_LostFocus" />
                        <TextBlock Text=" - " VerticalAlignment="Center" />
                        <TextBox Text="{Binding WindowEnd}" Width="60"
                                 LostFocus="HHmm_LostFocus" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="批间隔:" VerticalAlignment="Center"
                               ToolTip="每批发送之间的间隔秒数。上一批 SMTP 200 OK 后等这么久再发下一批（不受验证状态影响）。默认 30s，建议根据 SMTP 服务商限速和验证邮箱接收延迟调整。" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding SendIntervalSeconds}" Width="60"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 DataObject.Pasting="NumericRange_Pasting" />
                        <TextBlock Text=" 秒" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="批大小:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BatchSize}"
                             PreviewTextInput="NumericOnly_PreviewTextInput"
                             DataObject.Pasting="NumericRange_Pasting" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="冷却阈值:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CoolingFailures}"
                             PreviewTextInput="NumericOnly_PreviewTextInput"
                             DataObject.Pasting="NumericRange_Pasting" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="冷却(分):" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CoolingMinutes}"
                             PreviewTextInput="NumericOnly_PreviewTextInput"
                             DataObject.Pasting="NumericRange_Pasting" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="最大重试:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MaxRetries}"
                             PreviewTextInput="NumericOnly_PreviewTextInput"
                             DataObject.Pasting="NumericRange_Pasting" />
                </Grid>
            </GroupBox>

            <GroupBox Header="▼ 送达验证时间">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IMAP 轮询间隔:" VerticalAlignment="Center"
                               ToolTip="worker 主循环多久醒一次去检查验证邮箱（秒）。不影响批次首查前的等待时间——首查由'重查间隔'控制。建议 ≤ '重查间隔'。" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding VerificationPollIntervalSeconds}" Width="60"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 DataObject.Pasting="NumericRange_Pasting" />
                        <TextBlock Text=" 秒" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="重查间隔:" VerticalAlignment="Center"
                               ToolTip="批次发送后，等多久进入第一次检查（首查前等待时长）。与'IMAP 轮询间隔'的区别：轮询间隔是 worker 醒的频率，重查间隔决定每个批次多少秒后才允许被检查。建议 ≤ IMAP 轮询间隔的倍数。" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding VerificationRecheckIntervalSeconds}" Width="60"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 DataObject.Pasting="NumericRange_Pasting" />
                        <TextBlock Text=" 秒" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="轮询次数:" VerticalAlignment="Center"
                               ToolTip="批次检查达到此次数后仍未命中 → 标 unconfirmed，账号冷却" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding VerificationMaxPollAttempts}" Width="60"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 DataObject.Pasting="NumericRange_Pasting" />
                        <TextBlock Text=" 次（达到此次数仍未命中则未确认）" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="时间窗(小时):" VerticalAlignment="Center"
                               ToolTip="IMAP 每次查询只取 Received 时间在过去此值内的邮件。1h 通常足够覆盖发送→送达→验证邮件接收链路。" />
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding VerificationLookbackHours}" Width="60"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 DataObject.Pasting="NumericRange_Pasting" />
                        <TextBlock Text=" 小时" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="未确认冷却:" VerticalAlignment="Center"
                               ToolTip="达到轮询次数仍未命中后，账号冷却时长；冷却结束后批次回退 pending 重新发送" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding VerificationUnconfirmedCooldownMinutes}" Width="60"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 DataObject.Pasting="NumericRange_Pasting" />
                        <TextBlock Text=" 分钟" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="上一批验证等待:" VerticalAlignment="Center"
                               ToolTip="如果上一批还处于 Pending 状态（worker 未推进），主循环阻塞等待其被验证/未确认，最长等这么多秒。已 Verified 的批次不影响下一批（默认 30s 间隔照常发）。一般不需要调。" />
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding SendHoldOnUnverifiedSeconds}" Width="60"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"
                                 DataObject.Pasting="NumericRange_Pasting" />
                        <TextBlock Text=" 秒" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <Button Style="{StaticResource Button.Primary}" Content="保存配置" Margin="0,8,8,0" HorizontalAlignment="Right"
                    Command="{Binding SaveConfigCommand}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>