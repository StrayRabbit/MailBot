<UserControl x:Class="MailBot.App.Views.Pages.ComposePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MailBot.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <GroupBox Header="▼ 邮件内容">
                <StackPanel>
                    <TextBlock Text="主题：" Margin="0,0,0,2" />
                    <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="正文：" Margin="0,8,0,2" />
                    <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1" CornerRadius="6" Height="320">
                        <controls:HtmlEditor x:Name="BodyEditor" HtmlBody="{Binding HtmlBody, Mode=TwoWay}" />
                    </Border>

                    <TextBlock Text="附件：" Margin="0,8,0,2" />
                    <ListBox x:Name="AttachmentList" Height="100"
                             ItemsSource="{Binding AttachmentPaths}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="+ 添加附件" Margin="0,0,4,0" Click="AddAttachment_Click" />
                        <Button Content="删除选中" Click="RemoveAttachment_Click" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,8,0">
                <Button Content="测试发送" Margin="0,0,8,0" MinWidth="92"
                        ToolTip="把当前主题/正文/附件发一封到首个启用的验证邮箱,你需要在验证邮箱里登录查看。不消耗收件人配额,不参与送达验证。没配验证邮箱会弹提示去「账号」页配置。"
                        Click="TestSend_Click" />
                <Button Style="{StaticResource Button.Primary}" Content="保存配置"
                        Command="{Binding SaveConfigCommand}"
                        Click="SaveConfig_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>