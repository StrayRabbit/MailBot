<UserControl x:Class="MailBot.App.Views.Pages.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <StackPanel Margin="8">
        <GroupBox Header="{Binding Stats.DisplayTitle}">
            <StackPanel>
                <!-- 顶部日期范围工具条 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="开始日期" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize_Body}" Margin="0,0,8,0" />
                    <DatePicker Grid.Column="1" Width="140"
                                SelectedDate="{Binding Stats.StartDateUi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Column="2" Text="截止日期" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSize_Body}" Margin="16,0,8,0" />
                    <DatePicker Grid.Column="3" Width="140"
                                SelectedDate="{Binding Stats.EndDateUi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="4" Content="查询"
                            Command="{Binding Stats.RefreshChartCommand}"
                            Padding="14,4" Margin="8,0,0,0" />

                    <Button Grid.Column="5" Content="今日"
                            Command="{Binding Stats.SetPresetTodayCommand}"
                            Padding="14,4" Margin="8,0,0,0" />

                    <Button Grid.Column="6" Content="7天"
                            Command="{Binding Stats.SetPreset7DaysCommand}"
                            Padding="14,4" Margin="8,0,0,0" />

                    <Button Grid.Column="7" Content="30天"
                            Command="{Binding Stats.SetPreset30DaysCommand}"
                            Padding="14,4" Margin="8,0,0,0" />
                </Grid>

                <lvc:CartesianChart x:Name="Chart" LegendPosition="Hidden" ZoomMode="X" Height="380" />
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>