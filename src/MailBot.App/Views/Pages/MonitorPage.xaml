<UserControl x:Class="MailBot.App.Views.Pages.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:log="clr-namespace:MailBot.App.Logging"
             xmlns:conv="clr-namespace:MailBot.App.Converters">
    <UserControl.Resources>
        <conv:RecipientStatusToTextConverter x:Key="RecipientStatusText" />
    </UserControl.Resources>
    <StackPanel Margin="8">
        <GroupBox Header="▼ 实时监控">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Brush.Stat.Pending}" Margin="2" Padding="16" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="待发送" FontSize="{StaticResource FontSize_Body}" Foreground="{StaticResource Brush_Text_Secondary}"/>
                            <TextBlock Text="{Binding Monitor.PendingRecipients}" FontSize="{StaticResource FontSize_Display}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource Brush.Stat.Verifying}" Margin="2" Padding="16" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="验证中" FontSize="{StaticResource FontSize_Body}" Foreground="{StaticResource Brush_Text_Secondary}"/>
                            <TextBlock Text="{Binding Monitor.UnverifiedRecipients}" FontSize="{StaticResource FontSize_Display}" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Info}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource Brush.Stat.Sent}" Margin="2" Padding="16" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="今日已发" FontSize="{StaticResource FontSize_Body}" Foreground="{StaticResource Brush_Text_Secondary}"/>
                            <TextBlock Text="{Binding Monitor.TodaySentTotal}" FontSize="{StaticResource FontSize_Display}" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Warning}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{StaticResource Brush.Stat.Delivered}" Margin="2" Padding="16" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="已送达" FontSize="{StaticResource FontSize_Body}" Foreground="{StaticResource Brush_Text_Secondary}"/>
                            <TextBlock Text="{Binding Monitor.VerifiedRecipients}" FontSize="{StaticResource FontSize_Display}" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Success}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="{StaticResource Brush.Stat.Failed}" Margin="2" Padding="16" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="未送达/失败" FontSize="{StaticResource FontSize_Body}" Foreground="{StaticResource Brush_Text_Secondary}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Monitor.UnconfirmedRecipients}" FontSize="{StaticResource FontSize_Display}" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Danger}" />
                                <TextBlock Text=" / " FontSize="{StaticResource FontSize_Body}" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource Brush_Text_Secondary}"/>
                                <TextBlock Text="{Binding Monitor.FailedRecipients}" FontSize="{StaticResource FontSize_Display}" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Danger}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Margin="0,8,0,4">
                    <Run Text="账号配额: " />
                    <Run Text="{Binding Monitor.CurrentSenderSent, Mode=OneWay}" />
                    <Run Text=" / " />
                    <Run Text="{Binding Monitor.CurrentSenderQuota, Mode=OneWay}" />
                    <Run Text="  冷却: " />
                    <Run Text="{Binding Monitor.CooldownInfo, Mode=OneWay}" />
                    <Run Text="  状态: " />
                    <Run Text="{Binding Monitor.EngineStateText, Mode=OneWay}" />
                    <Run Text="  下一批: " />
                    <Run Text="{Binding Monitor.NextBatchHint, Mode=OneWay}" />
                </TextBlock>
                <ProgressBar Minimum="0" Maximum="100" Height="14"
                             Value="{Binding Monitor.ProgressPercent, Mode=OneWay}" />
                <TextBlock Margin="0,4,0,0">
                    <Run Text="当前批次: " />
                    <Run Text="{Binding Monitor.LastBatchSize, Mode=OneWay}" />
                    <Run Text=" 封 BCC" />
                </TextBlock>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="▼ 收件人状态 (最近)">
            <DataGrid ItemsSource="{Binding Monitor.RecentRecipients}"
                      AutoGenerateColumns="False" Height="240"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="邮箱" Binding="{Binding Email}" Width="*" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status, Converter={StaticResource RecipientStatusText}}" Width="80" />
                    <DataGridTextColumn Header="错误" Binding="{Binding ErrorMessage}" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Header="▼ 日志">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ItemsControl Grid.Row="0" x:Name="LogList"
                          ItemsSource="{Binding Monitor.Logs}" Height="220"
                          FontFamily="Consolas" FontSize="11"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type log:LogEntry}">
                            <Border Padding="6,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimestampText}"
                                               Foreground="{StaticResource Brush.Accent.Muted}" Width="40"
                                               FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding Symbol}" Margin="6,0" Width="16"
                                               Foreground="{Binding LevelBrush}"
                                               FontWeight="Bold"
                                               FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                               Foreground="{Binding LevelBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </GroupBox>
    </StackPanel>
</UserControl>