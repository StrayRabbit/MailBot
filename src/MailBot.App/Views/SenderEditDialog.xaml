<Window x:Class="MailBot.App.Views.SenderEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发件账号" Width="460" Height="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="邮箱：" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="EmailBox" Margin="0,4" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="SMTP 服务器：" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="HostBox" Margin="0,4" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="端口：" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="PortBox" Text="465" Margin="0,4" />

        <CheckBox Grid.Row="3" Grid.Column="1" x:Name="SslCheck" Content="使用 SSL" IsChecked="True" Margin="0,4" />

        <CheckBox Grid.Row="4" Grid.Column="1" x:Name="TrustInvalidCertCheck"
                  Content="信任无效证书（仅自建 / 虚拟空间邮箱）"
                  IsChecked="False" Margin="0,4"
                  ToolTip="服务器返回的证书主机名与 SMTP 域名不一致时勾选（如网易企业邮后端）。会降低 TLS 安全性。" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="用户名：" VerticalAlignment="Center" />
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="UsernameBox" Margin="0,4" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="密码：" VerticalAlignment="Center" />
        <PasswordBox Grid.Row="6" Grid.Column="1" x:Name="PasswordBox" Margin="0,4" />

        <TextBlock Grid.Row="7" Grid.Column="0" Text="每日配额：" VerticalAlignment="Center" />
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="QuotaBox" Text="50" Margin="0,4" />

        <TextBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                 x:Name="TestResult" Margin="0,8,0,0"
                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 MaxHeight="120" Foreground="{StaticResource Brush.Accent.Link}" />

        <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                   x:Name="Hint" Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.Accent.Hint}" />

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource Button.Link}" Content="测试连接" Margin="0,0,4,0" Click="Test_Click" />
            <Button Style="{StaticResource Button.Primary}" Content="保存" Width="80" Margin="0,0,8,0" Click="Save_Click" IsDefault="True" />
            <Button Style="{StaticResource Button.Link}" Content="取消" Click="Cancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>